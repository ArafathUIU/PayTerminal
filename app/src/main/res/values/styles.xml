<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.PayTerminal" parent="" />

    <!-- Base button style -->
    <style name="Widget.PayTerminal.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Primary rectangular button with orange fill -->
    <style name="Widget.PayTerminal.Button.Primary">
        <item name="backgroundTint">@color/orange</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Secondary rectangular button with orange outline, white fill -->
    <style name="Widget.PayTerminal.Button.Secondary">
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/orange</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/orange</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Outlined card with subtle border, soft shadow, moderate radius -->
    <style name="Widget.PayTerminal.Card">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/gray_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Important card with orange accent line on the left -->
    <style name="Widget.PayTerminal.Card.Accent">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/orange_light</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Dashboard stat tile -->
    <style name="Widget.PayTerminal.Card.Stat">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/gray_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Page heading (orange, medium/bold) -->
    <style name="TextAppearance.PayTerminal" parent="TextAppearance.Material3.BodyMedium" />

    <style name="TextAppearance.PayTerminal.Headline">
        <item name="android:textColor">@color/orange</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <!-- Section label -->
    <style name="TextAppearance.PayTerminal.SectionLabel">
        <item name="android:textColor">@color/gray_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Muted metadata -->
    <style name="TextAppearance.PayTerminal.Metadata">
        <item name="android:textColor">@color/gray_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Large financial number -->
    <style name="TextAppearance.PayTerminal.Money">
        <item name="android:textColor">@color/charcoal</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">40sp</item>
    </style>

    <!-- Numeric keypad key -->
    <style name="Widget.PayTerminal.Key" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/orange_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/orange</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>