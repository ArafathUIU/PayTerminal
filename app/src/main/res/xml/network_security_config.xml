<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dev only: allow plain HTTP to the local dev backend. The Android emulator
         reaches the host machine's loopback interface via 10.0.2.2. Everything
         else keeps the platform default (cleartext blocked). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
